<% if (success && success.length) { %>
    <div class="flash flash-success" role="alert">
        <% success.forEach((message) => { %>
            <p><%= message %></p>
        <% }) %>
    </div>
<% } %>

<% if (error && error.length) { %>
    <div class="flash flash-error" role="alert">
        <% error.forEach((message) => { %>
            <p><%= message %></p>
        <% }) %>
    </div>
<% } %>
