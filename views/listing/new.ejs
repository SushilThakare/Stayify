<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Listing | Wonderlust</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <div class="container navbar">
                <a class="brand" href="/listings">
                    <span class="brand-dot"></span>
                    Wonderlust
                </a>

                <div class="search-pill" aria-hidden="true">
                    <span>Where</span>
                    <span>Any week</span>
                    <span>Add guests</span>
                    <button class="search-action" type="button">&#9906;</button>
                </div>

                <div class="nav-actions">
                    <a class="btn btn-secondary" href="/listings">All Listings</a>
                    <% if (!currUser) { %>
                        <a class="btn btn-secondary" href="/signup">Sign Up</a>
                        <a class="btn btn-secondary" href="/login">Log In</a>
                    <% } else { %>
                        <a class="btn btn-secondary" href="/logout">Log Out</a>
                    <% } %>
                </div>
            </div>
        </header>

        <main class="main">
            <div class="container form-wrap">
                <%- include('../partials/flash') %>
                <section class="page-intro">
                    <div>
                        <h1>Create a new listing</h1>
                        <p>Share your place with travelers in a polished listing format.</p>
                    </div>
                </section>

                <section class="form-panel">
                    <form method="POST" action="/listings" class="needs-validation" novalidate>
                        <div class="form-grid">
                            <div class="field full">
                                <label class="label" for="title">Title</label>
                                <input class="input" id="title" type="text" name="title" placeholder="Beautiful stay in Pune" required data-validate-trim="true">
                                <div class="invalid-feedback">Name cannot be empty.</div>
                            </div>

                            <div class="field full">
                                <label class="label" for="description">Description</label>
                                <textarea class="textarea" id="description" name="description" placeholder="Describe what makes your place special" required data-validate-trim="true"></textarea>
                                <div class="invalid-feedback">Description cannot be empty.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="price">Price (INR)</label>
                                <input class="input" id="price" type="number" name="price" min="0" step="0.01" placeholder="4500" required data-validate-number="true">
                                <div class="invalid-feedback">Price must be a valid number.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="image">Image URL</label>
                                <input class="input" id="image" type="text" name="image" placeholder="https://example.com/photo.jpg" required data-validate-trim="true">
                                <div class="invalid-feedback">Image URL is required.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="location">Location</label>
                                <input class="input" id="location" type="text" name="location" placeholder="Pune" required data-validate-trim="true">
                                <div class="invalid-feedback">Location is required.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="country">Country</label>
                                <input class="input" id="country" type="text" name="country" placeholder="India" required data-validate-trim="true">
                                <div class="invalid-feedback">Country is required.</div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-primary" type="submit">Create Listing</button>
                            <a class="btn btn-secondary" href="/listings">Cancel</a>
                        </div>
                    </form>
                </section>
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section>
                    <h4>Support</h4>
                    <p>Help Centre</p>
                    <p>Safety information</p>
                    <p>Cancellation options</p>
                </section>
                <section>
                    <h4>Hosting</h4>
                    <p>List your home</p>
                    <p>Host resources</p>
                    <p>Community forum</p>
                </section>
                <section>
                    <h4>Wonderlust</h4>
                    <p>About</p>
                    <p>Careers</p>
                    <p>Newsroom</p>
                </section>
            </div>
            <div class="container footer-bottom">© 2026 Wonderlust. Designed for modern stays.</div>
        </footer>
    </div>
    <script src="/js/script.js"></script>
</body>
</html>