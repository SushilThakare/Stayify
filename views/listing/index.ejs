<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wonderlust | All Listings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <div class="container navbar">
                <a class="brand" href="/listings">
                    <span class="brand-dot"></span>
                    Wonderlust
                </a>

                <div class="search-pill" aria-hidden="true">
                    <span>Where</span>
                    <span>Any week</span>
                    <span>Add guests</span>
                    <button class="search-action" type="button">&#9906;</button>
                </div>

                <div class="nav-actions">
                    <a class="btn btn-primary" href="/listings/new">Create Listing</a>
                    <% if (!currUser) { %>
                        <a class="btn btn-secondary" href="/signup">Sign Up</a>
                        <a class="btn btn-secondary" href="/login">Log In</a>
                    <% } else { %>
                        <a class="btn btn-secondary" href="/logout">Log Out</a>
                    <% } %>
                </div>
            </div>
        </header>

        <main class="main">
            <div class="container">
                <%- include('../partials/flash') %>
                <section class="page-intro">
                    <div>
                        <h1>Find your next stay</h1>
                        <p>Curated homes, unique spaces, and hand-picked comfort.</p>
                    </div>
                    <div class="chips">
                        <span class="chip active">Popular</span>
                        <span class="chip">Beachfront</span>
                        <span class="chip">Mountain</span>
                        <span class="chip">City</span>
                    </div>
                </section>

                <% if (allListings.length === 0) { %>
                    <section class="empty-state">
                        <h2>No listings yet</h2>
                        <p>Start by creating your first place and it will appear here.</p>
                        <div class="form-actions" style="justify-content:center;">
                            <a class="btn btn-primary" href="/listings/new">Create Listing</a>
                        </div>
                    </section>
                <% } else { %>
                    <section class="listing-grid">
                        <% for (let listing of allListings) { %>
                            <a class="listing-card" href="/listings/<%= listing._id %>">
                                <div class="card-media">
                                    <% if (listing.image) { %>
                                        <img src="<%= listing.image %>" alt="<%= listing.title %>">
                                    <% } %>
                                    <span class="card-save" aria-hidden="true">&#9825;</span>
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title"><%= listing.title %></h3>
                                    <p class="card-meta"><%= listing.location %>, <%= listing.country %></p>
                                    <p class="card-price"><strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong> for 1 night</p>
                                </div>
                            </a>
                        <% } %>
                    </section>
                <% } %>
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section>
                    <h4>Support</h4>
                    <p>Help Centre</p>
                    <p>Safety information</p>
                    <p>Cancellation options</p>
                </section>
                <section>
                    <h4>Hosting</h4>
                    <p>List your home</p>
                    <p>Host resources</p>
                    <p>Community forum</p>
                </section>
                <section>
                    <h4>Wonderlust</h4>
                    <p>About</p>
                    <p>Careers</p>
                    <p>Newsroom</p>
                </section>
            </div>
            <div class="container footer-bottom">© 2026 Wonderlust. Designed for modern stays.</div>
        </footer>
    </div>
</body>
</html>
