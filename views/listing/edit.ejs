<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing | Stayify</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <div class="container navbar">
                <div class="brand-group">
                    <a class="brand" href="/listings">
                        <span class="brand-dot"></span>
                        Stayify
                    </a>
                    <div class="brand-sub" aria-hidden="true">
                        <span id="rotating-headline" class="rotating-text">Weekend escapes</span>
                    </div>
                </div>

                <div class="nav-actions">
                    <a class="btn btn-secondary" href="/listings/<%= listing._id %>">View Listing</a>
                    <a class="btn btn-primary" href="/listings/new">Create New</a>
                    <% if (!currUser) { %>
                        <a class="btn btn-secondary" href="/signup">Sign Up</a>
                        <a class="btn btn-secondary" href="/login">Log In</a>
                    <% } else { %>
                        <a class="btn btn-secondary" href="/logout">Log Out</a>
                    <% } %>
                </div>
            </div>
        </header>

        <main class="main">
            <div class="container form-wrap">
                <%- include('../partials/flash') %>
                <section class="page-intro">
                    <div>
                        <h1>Edit listing</h1>
                        <p>Update details and keep your listing fresh for guests.</p>
                    </div>
                    <a class="btn btn-secondary" href="/listings/<%= listing._id %>">Back to details</a>
                </section>

                <section class="form-panel">
                    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
                        <div class="form-grid">
                            <div class="field full">
                                <label class="label" for="title">Title</label>
                                <input class="input" type="text" id="title" name="title" value="<%= listing.title %>" required data-validate-trim="true">
                                <div class="invalid-feedback">Title cannot be empty.</div>
                            </div>

                            <div class="field full">
                                <label class="label" for="description">Description</label>
                                <textarea class="textarea" id="description" name="description" required data-validate-trim="true"><%= listing.description %></textarea>
                                <div class="invalid-feedback">Please enter a description.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="price">Price (INR)</label>
                                <input class="input" type="number" id="price" name="price" value="<%= listing.price %>" min="0" step="0.01" required data-validate-number="true">
                                <div class="invalid-feedback">Please enter a valid price.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="image">Image URL</label>
                                <input class="input" type="text" id="image" name="image" value="<%= listing.image %>" required data-validate-trim="true">
                                <div class="invalid-feedback">Image URL is required.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="location">Location</label>
                                <input class="input" type="text" id="location" name="location" value="<%= listing.location %>" required data-validate-trim="true">
                                <div class="invalid-feedback">Location is required.</div>
                            </div>

                            <div class="field">
                                <label class="label" for="country">Country</label>
                                <input class="input" type="text" id="country" name="country" value="<%= listing.country %>" required data-validate-trim="true">
                                <div class="invalid-feedback">Country is required.</div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-primary" type="submit">Update Listing</button>
                            <a class="btn btn-secondary" href="/listings/<%= listing._id %>">Cancel</a>
                        </div>
                    </form>
                </section>
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section>
                    <h4>Support</h4>
                    <p>Help Centre</p>
                    <p>Safety information</p>
                    <p>Cancellation options</p>
                </section>
                <section>
                    <h4>Hosting</h4>
                    <p>List your home</p>
                    <p>Host resources</p>
                    <p>Community forum</p>
                </section>
                <section>
                    <h4>Stayify</h4>
                    <p>About</p>
                    <p>Careers</p>
                    <p>Newsroom</p>
                </section>
            </div>
            <div class="container footer-bottom">© 2026 Stayify. Designed for modern stays.</div>
        </footer>
    </div>
    <script src="/js/script.js"></script>
</body>
</html>