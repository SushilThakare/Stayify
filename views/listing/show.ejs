<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> | Wonderlust</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <div class="container navbar">
                <a class="brand" href="/listings">
                    <span class="brand-dot"></span>
                    Wonderlust
                </a>

                <div class="search-pill" aria-hidden="true">
                    <span>Anywhere</span>
                    <span>Any week</span>
                    <span>Add guests</span>
                    <button class="search-action" type="button">&#9906;</button>
                </div>

                <div class="nav-actions">
                    <a class="btn btn-secondary" href="/listings">All Listings</a>
                    <a class="btn btn-primary" href="/listings/new">Create Listing</a>
                    <% if (!currUser) { %>
                        <a class="btn btn-secondary" href="/signup">Sign Up</a>
                        <a class="btn btn-secondary" href="/login">Log In</a>
                    <% } else { %>
                        <a class="btn btn-secondary" href="/logout">Log Out</a>
                    <% } %>
                </div>
            </div>
        </header>

        <main class="main">
            <div class="container">
                <%- include('../partials/flash') %>
                <section class="page-intro">
                    <div>
                        <h1><%= listing.title %></h1>
                        <p><%= listing.location %>, <%= listing.country %></p>
                    </div>
                    <div class="chips">
                        <span class="chip active">Guest favorite</span>
                        <span class="chip">Verified listing</span>
                    </div>
                </section>

                <section class="detail-layout">
                    <div>
                        <div class="detail-hero">
                            <% if (listing.image) { %>
                                <img src="<%= listing.image %>" alt="<%= listing.title %>">
                            <% } %>
                        </div>

                        <article class="detail-section">
                            <h3>About this place</h3>
                            <p><%= listing.description %></p>
                        </article>

                        <article class="detail-section">
                            <h3>Location details</h3>
                            <div class="chips">
                                <span class="chip"><%= listing.location %></span>
                                <span class="chip"><%= listing.country %></span>
                            </div>
                        </article>
                    </div>

                    <aside class="side-card">
                        <p class="price">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span>night</span></p>
                        <div class="side-actions">
                            <a class="btn btn-primary" href="/listings/<%= listing._id %>/edit">Edit Listing</a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                <button class="btn btn-danger" type="submit">Delete Listing</button>
                            </form>
                            <a class="btn btn-secondary" href="/listings">Back to Listings</a>
                        </div>
                    </aside>

                    <article class="reviews-section"> 
                        <h3>Leave a Review</h3>
                        <form method="POST" action="/listings/<%= listing.id %>/reviews" class="review-form needs-validation" novalidate>
                            <div class="field">
                                <label for="rating" class="label">Rating:</label>
                                <select id="rating" name="rating" class="input select-input form-select" required>
                                    <option value="">Select a rating</option>
                                    <option value="1">1 - Poor</option>
                                    <option value="2">2 - Fair</option>
                                    <option value="3">3 - Good</option>
                                    <option value="4">4 - Very Good</option>
                                    <option value="5">5 - Excellent</option>
                                </select>
                                <div class="invalid-feedback">
                                    Please select a rating.
                                </div>
                            </div>
                            <div class="field full">
                                <label for="comment" class="label">Comment:</label>
                                <textarea id="comment" name="comment" class="textarea form-control" placeholder="Share your experience..." minlength="5" required></textarea>
                                <div class="invalid-feedback">
                                    Please provide a comment (at least 5 characters).
                                </div>
                            </div>
                            <div class="review-actions">
                                <button type="submit" class="btn btn-primary">Submit Review</button>
                            </div>
                        </form>
                    </article>
                    <hr>
                    <article class="reviews-section">
                        <h3>Reviews</h3>
                        
                        <% if (listing.reviews && listing.reviews.length > 0) { %>
                            <div class="reviews-container">
                                <% for (let review of listing.reviews) { %>
                                    <div class="card review-card mb-3">
                                        <div class="card-body">
                                            <div class="review-header">
                                                <div class="review-rating">
                                                    <% for (let i = 0; i < review.rating; i++) { %>
                                                        <span class="star filled">★</span>
                                                    <% } %>
                                                    <% for (let i = review.rating; i < 5; i++) { %>
                                                        <span class="star">★</span>
                                                    <% } %>
                                                    <span class="rating-text">(<%= review.rating %>/5)</span>
                                                </div>
                                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                    <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                                                </form>
                                            </div>
                                            <p class="card-text review-comment"><%= review.comment %></p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info" role="alert">
                                <p>No reviews yet. Be the first to review this listing!</p>
                            </div>
                        <% } %>
                    </article>
                </section>
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section>
                    <h4>Support</h4>
                    <p>Help Centre</p>
                    <p>Safety information</p>
                    <p>Cancellation options</p>
                </section>
                <section>
                    <h4>Hosting</h4>
                    <p>List your home</p>
                    <p>Host resources</p>
                    <p>Community forum</p>
                </section>
                <section>
                    <h4>Wonderlust</h4>
                    <p>About</p>
                    <p>Careers</p>
                    <p>Newsroom</p>
                </section>
            </div>
            <div class="container footer-bottom">© 2026 Wonderlust. Designed for modern stays.</div>
        </footer>
        
    </div>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/js/script.js"></script>
</body>
</html>